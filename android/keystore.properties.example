# Copy this file to keystore.properties (same directory, next to build.gradle) and fill in real
# values. keystore.properties is gitignored -- never commit it, and never commit the keystore file
# it points at either (android/.gitignore already excludes *.jks/*.keystore everywhere).
#
# The keystore itself should only ever exist on your own machine (or a secrets manager), generated
# with e.g.:
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 9125
# See issue #125 for the full release/Play Store checklist.

storeFile=/absolute/path/to/upload-keystore.jks
storePassword=changeme
keyAlias=upload
keyPassword=changeme
